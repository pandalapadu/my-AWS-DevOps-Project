#!/bin/bash

set -e

echo ">>> Expanding disk..."

growpart /dev/nvme0n1 ${partition_number}
lvextend -r -L +${extend_size}G /dev/mapper/RootVG-varVol
xfs_growfs /var

# Manual Way to extend
# growpart /dev/nvme0n1 4
# lvextend -r -L +30G /dev/mapper/RootVG-varVol
# xfs_growfs /var

echo ">>> Installing Docker..."

dnf install -y dnf-plugins-core

dnf config-manager --add-repo \
  https://download.docker.com/linux/rhel/docker-ce.repo

dnf install -y \
  docker-ce \
  docker-ce-cli \
  containerd.io \
  docker-buildx-plugin \
  docker-compose-plugin

echo ">>> Starting Docker..."

systemctl enable --now docker

echo ">>> Adding ec2-user to Docker group..."

usermod -aG docker ec2-user

echo ">>> Verifying installation..."

docker --version
docker compose version
systemctl is-active docker
getent group docker
ls -l /var/run/docker.sock

echo ""
echo "=========================================="
echo " SETUP COMPLETED"
echo "=========================================="
echo ""
echo "Docker is installed and enabled."
echo "ec2-user has been added to the docker group."
echo ""
echo "IMPORTANT: reconnect your SSH session."
echo "Then run:"
echo ""
echo "    docker ps"
echo ""
echo "=========================================="