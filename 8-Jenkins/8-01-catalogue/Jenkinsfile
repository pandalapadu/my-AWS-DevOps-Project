pipeline {

    agent {
        node {
            label 'ROBOSHOP'
        }
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 15, unit: 'MINUTES')
    }
// Build Stage 
    stages {
        stage('Read Version') {
            steps {
                script {
                    // If in a subfolder, use: file: 'frontend/package.json'
                    // // Read directly using the relative repository path
                    def packageJson = readJSON file: '8-Jenkins/8-01-catalogue/package.json'

                    // Access any field directly
                    def appName    = packageJson.name
                    def appVersion = packageJson.version

                    echo "Application: ${appName}"
                    echo "Version: ${appVersion}"

                    // Export to an environment variable for downstream stages
                    env.APP_NAME    = appName
                    env.APP_VERSION = appVersion
                }
            }
        }
        stage('Build') {
            steps {
                script """
                    echo "Building version ${env.APP_VERSION}..."
                """
            }
        }

        stage('Test') {
            steps {
                sh '''
                    echo "=============================="
                    echo "Catalogue Test Stage"
                    echo "=============================="
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    echo "=============================="
                    echo "Catalogue Deploy Stage"
                    echo "=============================="
                '''
            }
        }
    }

    post {
        always {
            echo "it will run always"
        }

        success {
            echo "I will run only success"
        }

        failure {
            echo "I will run if build failed"
        }
    }
}