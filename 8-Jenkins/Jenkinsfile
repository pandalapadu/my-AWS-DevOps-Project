pipeline {
    agent {
        node { label 'ROBOSHOP' } //## Agent Lable we will provide here
    }
    //environment variables
    environment {
        COURSE = "Jenkins Learning"
    }
    //Build Section
    stages {
        stage('Build') {
            steps {
                script {
                    sh """
                        echo "Building Stage"
                        echo "Today we are learning: ${COURSE}"
                        sleep 5
                    """
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    sh """
                        echo "Building Testing"
                    """
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    sh """
                        echo "Building Deploy"
                    """
                }
            }
        }
    }
    //Post Build 
    post {
        always {
            echo "it will run always"
        }
        success {
            echo "I will run only success"
        }
        failure {
            echo "I will run if build failed "
        }
    }

}